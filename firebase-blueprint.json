{
  "entities": {
    "Circular": {
      "title": "Circular",
      "description": "Union circular, official order, or notice",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of circular or notice" },
        "category": { "type": "string", "description": "Union cadre or topic category" },
        "snippet": { "type": "string", "description": "Short summary" },
        "contentHtml": { "type": "string", "description": "Full HTML description/body" },
        "fileLinks": { "type": "array", "description": "Uploaded or linked official document/PDF links" },
        "imageUrls": { "type": "array", "description": "Uploaded or linked photo URLs" },
        "published": { "type": "string", "description": "ISO date string" },
        "author": { "type": "string", "description": "Author or issuing body" },
        "urgent": { "type": "boolean", "description": "Whether this is urgent flash news" }
      },
      "required": ["title", "category", "snippet", "published"]
    },
    "ExecutiveMember": {
      "title": "ExecutiveMember",
      "description": "Office bearer details for Dhenkanal Division",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name with Comrade title" },
        "designation": { "type": "string", "description": "Union post / designation" },
        "branch": { "type": "string", "description": "Union wing / branch" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "location": { "type": "string", "description": "Office / Sub Post Office location" },
        "roleType": { "type": "string", "description": "president, secretary, treasurer, or executive" },
        "photoUrl": { "type": "string", "description": "Profile portrait or avatar image URL" }
      },
      "required": ["name", "designation", "branch", "location"]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Featured hero banner slides for DakShiksha home page",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Headline of the slide" },
        "subtitle": { "type": "string", "description": "Description text / writings" },
        "tag": { "type": "string", "description": "Tag badge text" },
        "imageUrl": { "type": "string", "description": "Banner photo URL" },
        "ctaText": { "type": "string", "description": "Call to action label" },
        "ctaLink": { "type": "string", "description": "Target section or URL" },
        "gradient": { "type": "string", "description": "Color theme gradient" },
        "order": { "type": "number", "description": "Display order index" },
        "active": { "type": "boolean", "description": "Whether visible" }
      },
      "required": ["title", "subtitle", "imageUrl"]
    },
    "NewsSliderItem": {
      "title": "NewsSliderItem",
      "description": "Headlines and writings displayed in moving news ticker slider",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "News headline text" },
        "category": { "type": "string", "description": "Category or badge" },
        "link": { "type": "string", "description": "Optional click link or circular ID" },
        "isUrgent": { "type": "boolean", "description": "Whether urgent flash headline" },
        "published": { "type": "string", "description": "ISO date string" },
        "order": { "type": "number", "description": "Display order index" }
      },
      "required": ["title"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Urgent union and departmental announcements with red bell header",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title or subject of announcement" },
        "link": { "type": "string", "description": "Optional click URL or order link" },
        "published": { "type": "string", "description": "Date or timestamp" },
        "order": { "type": "number", "description": "Display order" },
        "active": { "type": "boolean", "description": "Visibility flag" }
      },
      "required": ["title"]
    },
    "ImportantDocument": {
      "title": "ImportantDocument",
      "description": "Key workflow documents, leave rules, and claim forms with LINK badge",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Document name" },
        "url": { "type": "string", "description": "Direct file or webpage link" },
        "category": { "type": "string", "description": "Document category tag" },
        "order": { "type": "number", "description": "Display order" },
        "published": { "type": "string", "description": "Publication date" }
      },
      "required": ["title", "url"]
    },
    "NoticeCircular": {
      "title": "NoticeCircular",
      "description": "Categorized notices and circulars (Notice, Accommodation, CGHS, Pension/Salary, Miscellaneous)",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Notice or circular title" },
        "category": { "type": "string", "description": "Category tab name" },
        "published": { "type": "string", "description": "Date published (YYYY-MM-DD)" },
        "url": { "type": "string", "description": "Target download or view link" },
        "order": { "type": "number", "description": "Display order" }
      },
      "required": ["title", "category", "published"]
    },
    "UnionDocumentRuling": {
      "title": "UnionDocumentRuling",
      "description": "Union Constitution, trade union rulings, Form 'B' register entries, and grievance templates",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Document or ruling title" },
        "desc": { "type": "string", "description": "Brief description of the ruling or document" },
        "link": { "type": "string", "description": "URL or download link to the document" },
        "type": { "type": "string", "description": "Category or document type (Legal, Constitution, Grievance, etc.)" },
        "order": { "type": "number", "description": "Display order index" },
        "published": { "type": "string", "description": "Publication or entry date" }
      },
      "required": ["title", "link", "type"]
    },
    "OrderRulingGuide": {
      "title": "OrderRulingGuide",
      "description": "Uploaded postal department orders, union rulings, and cadre guides in card view",
      "type": "object",
      "properties": {
        "fileName": { "type": "string", "description": "Display name of the uploaded document or order file" },
        "folderName": { "type": "string", "description": "Folder grouping name (e.g. Postal Manuals, Rule 38 Transfers)" },
        "category": { "type": "string", "description": "Category badge (Orders, Rulings, Guide, Manuals, etc.)" },
        "documentUrl": { "type": "string", "description": "Direct URL or Google Drive link to document" },
        "published": { "type": "string", "description": "Date published (YYYY-MM-DD)" },
        "order": { "type": "number", "description": "Display order index" },
        "notes": { "type": "string", "description": "Optional notes or details" }
      },
      "required": ["fileName", "folderName", "category", "documentUrl"]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "Official union member profile record in Dhenkanal Division",
      "type": "object",
      "properties": {
        "membershipId": { "type": "string", "description": "Unique format AIPEU-DKL-XXXX" },
        "name": { "type": "string", "description": "Member's full name" },
        "mobile": { "type": "string", "description": "10-digit registered mobile number" },
        "email": { "type": "string", "description": "Member email" },
        "cadre": { "type": "string", "description": "Designation/Cadre" },
        "office": { "type": "string", "description": "Office or Post Office" },
        "division": { "type": "string", "description": "Dhenkanal" },
        "address": { "type": "string", "description": "Residential address" },
        "joiningDate": { "type": "string", "description": "Date of joining union" },
        "status": { "type": "string", "description": "Active, Pending, Expired" },
        "validFrom": { "type": "string", "description": "Validity start date" },
        "validUntil": { "type": "string", "description": "Validity expiry date" },
        "photoUrl": { "type": "string", "description": "Member photo" },
        "activeCardId": { "type": "string", "description": "ID of current issued membership card" }
      },
      "required": ["membershipId", "name", "mobile", "cadre", "office", "division", "status"]
    },
    "MemberCredential": {
      "title": "MemberCredential",
      "description": "Secure salted PBKDF2 hash credential for member login",
      "type": "object",
      "properties": {
        "membershipId": { "type": "string", "description": "Membership ID" },
        "mobile": { "type": "string", "description": "Normalized mobile number" },
        "passwordHash": { "type": "string", "description": "PBKDF2 SHA-256 hash" },
        "salt": { "type": "string", "description": "Cryptographic salt" }
      },
      "required": ["membershipId", "mobile", "passwordHash", "salt"]
    },
    "ProfileUpdateRequest": {
      "title": "ProfileUpdateRequest",
      "description": "Member change requests pending administrator review and approval",
      "type": "object",
      "properties": {
        "membershipId": { "type": "string", "description": "Member ID" },
        "proposedChanges": { "type": "object", "description": "Field modifications proposed by member" },
        "status": { "type": "string", "description": "Pending, Approved, Rejected" },
        "submittedAt": { "type": "string", "description": "Submission timestamp" }
      },
      "required": ["membershipId", "status", "submittedAt"]
    },
    "DigitalMembershipCard": {
      "title": "DigitalMembershipCard",
      "description": "Issued digital membership card metadata and QR token",
      "type": "object",
      "properties": {
        "membershipId": { "type": "string", "description": "Membership ID" },
        "cardToken": { "type": "string", "description": "Unguessable 24-character random verification token" },
        "status": { "type": "string", "description": "Valid, Expired, Revoked, Replaced" },
        "issueDate": { "type": "string", "description": "Date of issue" },
        "expiryDate": { "type": "string", "description": "Validity expiration date" }
      },
      "required": ["membershipId", "cardToken", "status", "issueDate", "expiryDate"]
    },
    "CardVerification": {
      "title": "CardVerification",
      "description": "Public card verification lookup without exposing private member PII",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Token key" },
        "membershipId": { "type": "string", "description": "AIPEU-DKL-XXXX" },
        "memberName": { "type": "string", "description": "Member name" },
        "cadre": { "type": "string", "description": "Cadre" },
        "office": { "type": "string", "description": "Office" },
        "division": { "type": "string", "description": "Dhenkanal" },
        "status": { "type": "string", "description": "Valid, Expired, Revoked" },
        "validFrom": { "type": "string", "description": "Valid from date" },
        "validUntil": { "type": "string", "description": "Valid until date" }
      },
      "required": ["token", "membershipId", "memberName", "status"]
    },
    "MemberAuditLog": {
      "title": "MemberAuditLog",
      "description": "Administrator audit trail for member lifecycle and card events",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Action performed" },
        "actor": { "type": "string", "description": "Administrator identity" },
        "targetMembershipId": { "type": "string", "description": "Target member ID" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "details": { "type": "string", "description": "Action specifics without secrets" }
      },
      "required": ["action", "actor", "targetMembershipId", "timestamp"]
    }
  },
  "firestore": {
    "/circulars/{circularId}": {
      "schema": "Circular",
      "description": "Collection of union circulars, orders and latest news items added by admins"
    },
    "/executiveMembers/{memberId}": {
      "schema": "ExecutiveMember",
      "description": "Directory of executive office bearers for Dhenkanal Division"
    },
    "/heroSlides/{slideId}": {
      "schema": "HeroSlide",
      "description": "Dynamic hero carousel slides for DakShiksha home page"
    },
    "/newsSliderItems/{itemId}": {
      "schema": "NewsSliderItem",
      "description": "Moving news ticker slider items managed by admin"
    },
    "/announcements/{annId}": {
      "schema": "Announcement",
      "description": "Announcements displayed below hero slider"
    },
    "/importantDocuments/{docId}": {
      "schema": "ImportantDocument",
      "description": "Important documents list with link badges"
    },
    "/noticeCirculars/{ncId}": {
      "schema": "NoticeCircular",
      "description": "Categorized notices and circulars with published date"
    },
    "/unionDocumentsAndRulings/{docId}": {
      "schema": "UnionDocumentRuling",
      "description": "Trade union rulings, Constitution, Form B, and grievance documents managed in Executive Bearer section"
    },
    "/ordersRulingsGuides/{docId}": {
      "schema": "OrderRulingGuide",
      "description": "Uploaded postal department orders, union rulings, and cadre guides in card view"
    },
    "/members/{memberId}": {
      "schema": "MemberProfile",
      "description": "Approved union member profiles in Dhenkanal Division"
    },
    "/memberCredentials/{memberId}": {
      "schema": "MemberCredential",
      "description": "PBKDF2 salted hash credentials for member authentication"
    },
    "/profileUpdateRequests/{requestId}": {
      "schema": "ProfileUpdateRequest",
      "description": "Profile change proposals submitted by members for admin approval"
    },
    "/membershipCards/{cardId}": {
      "schema": "DigitalMembershipCard",
      "description": "Issued digital membership cards with QR codes and lifecycle status"
    },
    "/cardVerifications/{tokenId}": {
      "schema": "CardVerification",
      "description": "Public certificate verification records checked via QR code scanning without private PII"
    },
    "/memberAuditLogs/{logId}": {
      "schema": "MemberAuditLog",
      "description": "Tamper-evident audit trail of all membership administrative actions"
    }
  }
}
